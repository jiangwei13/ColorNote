        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColorNote">
        <activity
            android:name="b.YJTI"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="b.YJTJ" />
        <activity android:name="b.YJTK" />
        <activity android:name="b.YJTL" />
        <activity android:name="b.YJTM" />
        <activity android:name="b.YJTN" />

        <provider
            android:name="c.YJTO"
            android:enabled="true"
            android:exported="true"
            android:authorities="${applicationId}.p0"
            android:syncable="true">
            <meta-data
                android:name="@string/dd_str"
                android:value="true" />
        </provider>

    </application>

</manifest>